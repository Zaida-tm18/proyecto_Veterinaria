# Copia este archivo a ".env" y ajusta los valores a tu instalación de PostgreSQL

PORT=4000

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=vetpass123
PGDATABASE=veterinaria

# Clave secreta para firmar tokens JWT (usa cualquier cadena larga y aleatoria)
JWT_SECRET=dev_secret_local_no_usar_en_produccion_cambia_esto_1234567890
JWT_EXPIRES_IN=8h
